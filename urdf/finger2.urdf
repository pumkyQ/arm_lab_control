<?xml version="1.0" encoding="utf-8"?>
<robot name="kitech_finger_3dof">

  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="accent_blue">
    <color rgba="0.1 0.4 0.8 1.0"/>
  </material>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.0358"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.0358" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.0358" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.0358"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.0358" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.0716" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.0358"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.0358" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0 0 0.1074" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.0405"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

</robot>